# Web App — Environment Variables

# Soroban RPC (used client-side for writes)
NEXT_PUBLIC_RPC_URL=https://rpc-futurenet.stellar.org

# Contract IDs (from deployment)
NEXT_PUBLIC_REGISTRY_ID=C...
NEXT_PUBLIC_ESCROW_ID=C...

# x402 facilitator
NEXT_PUBLIC_FACILITATOR_URL=https://facilitator.stellar.org

# Indexer API (used server/client for reads)
INDEXER_API_URL=http://localhost:3001
NEXT_PUBLIC_INDEXER_API_URL=http://localhost:3001
